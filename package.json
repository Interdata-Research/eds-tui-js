{
  "name": "eds-tui",
  "version": "0.6.3",
  "description": "Ed's terminal AI assistant — your LLM. Natural language command executor for a local Ollama model.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ask": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map"
  ],
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "dev": "node node_modules/typescript/bin/tsc -p tsconfig.json --watch",
    "test": "node --test dist/**/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "marked": "^12.0.2",
    "marked-terminal": "^7.3.0",
    "ollama": "^0.6.3",
    "ora": "^9.4.1",
    "string-width": "^8.2.2",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2"
  }
}
